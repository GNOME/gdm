#: common/gdm-common.c:324
#, c-format
msgid "/dev/urandom is not a character device"
msgstr "nyns yw /dev/urandom devis lytheren"

#: common/gdm-common.c:358
msgid "Unable to create transient display: "
msgstr "Ny yllir gwruthyl displetyans anparhus:"

#: common/gdm-common.c:555
msgid "Could not identify the current session: "
msgstr "Ny yllir aswon an esedhek a-lemmyn:"

#: common/gdm-common.c:564
#, c-format
msgid "Could not identify the current seat."
msgstr "Ny yllir aswon an esedh a-lemmyn."

#: daemon/gdm-manager.c:700 daemon/gdm-manager.c:736
msgid "No display available"
msgstr "Nyns eus displetyans kavadow"

#: daemon/gdm-manager.c:803 daemon/gdm-manager.c:1110
msgid "No session available"
msgstr "Nyns eus esedhek kavadow"

#: daemon/gdm-manager.c:819
msgid "Can only be called before user is logged in"
msgstr "Y hyll bos gelwys hepken kyns usi an devnydhyer omgelmys"

#: daemon/gdm-manager.c:831
msgid "Caller not GDM"
msgstr "Nyns yw GDM galowyer"

#: daemon/gdm-manager.c:841
msgid "Unable to open private communication channel"
msgstr "Ny yllir ygeri kanel geskomunyans privedh"

#: daemon/gdm-session.c:1507
msgid "Could not create authentication helper process"
msgstr "Ny yllir gwruthyl argerdh gwereser omgelmyans"

#: daemon/gdm-session-worker.c:822
msgid ""
"You reached the maximum password authentication attempts, please try another "
"method"
msgstr ""
"Hwi re hedhas an niver a assayys omgelmyans ger-tremena ughboyntel, "
"assayewgh method aral mar pleg"

#: daemon/gdm-session-worker.c:825
msgid ""
"You reached the maximum auto login attempts, please try another "
"authentication method"
msgstr ""
"Hwi re hedhas an niver a assayys omgelmyans awtomatek ughboyntel, assayewgh "
"method omgelmyans aral mar pleg"

#: daemon/gdm-session-worker.c:828
msgid ""
"You reached the maximum fingerprint authentication attempts, please try "
"another method"
msgstr ""
"Hwi re hedhas an niver a assayys omgelmyans bys-prynt ughboyntel, assayewgh "
"method aral mar pleg"

#: daemon/gdm-session-worker.c:831
msgid ""
"You reached the maximum smart card authentication attempts, please try "
"another method"
msgstr ""
"Hwi re hedhas an niver a assayys omgelmyans karten gonnyk ughboyntel, "
"assayewgh method aral mar pleg"

#: daemon/gdm-session-worker.c:833
msgid ""
"You reached the maximum authentication attempts, please try another method"
msgstr ""
"Hwi re hedhas an niver a assayys omgelmyans ughboyntel, assayewgh method "
"aral mar pleg"

#: daemon/gdm-session-worker.c:840
msgid "Sorry, password authentication didn’t work. Please try again."
msgstr "Diharesow, ny oberas omgelmyans ger-tremena. Assayewgh arta mar pleg."

#: daemon/gdm-session-worker.c:843
msgid "Sorry, auto login didn’t work. Please try again."
msgstr "Diharesow, ny oberas omgelmyans awtomatek. Assayewgh arta mar pleg."

#: daemon/gdm-session-worker.c:846
msgid "Sorry, fingerprint authentication didn’t work. Please try again."
msgstr "Diharesow, ny oberyas omgelmyans bys-prynt. Assayewgh arta mar pleg."

#: daemon/gdm-session-worker.c:849
msgid "Sorry, smart card authentication didn’t work. Please try again."
msgstr "Diharesow, ny oberas karten gonnyk. Assayewgh arta mar pleg."

#: daemon/gdm-session-worker.c:851
msgid "Sorry, that didn’t work. Please try again."
msgstr "Diharesow, ny oberas henna. Assaya arta mar pleg."

#: daemon/gdm-session-worker.c:866
msgid "Your account was given a time limit that’s now passed."
msgstr "Yth esa finweth termyn res dh'gas akont neb usi passys y'n eur ma."

#: daemon/gdm-session-worker.c:1300
msgid "Username:"
msgstr "Hanow devnydhyer:"

#: daemon/gdm-session-worker.c:1726 daemon/gdm-session-worker.c:1743
#, c-format
msgid "no user account available"
msgstr "nyns eus akont devnydhyer kavadow"

#: daemon/gdm-session-worker.c:1770
msgid "Unable to change to user"
msgstr "Ny yllir chanjya dhe dhevnydhyer"

#: daemon/gdm-wayland-session.c:513
msgid "GNOME Display Manager Wayland Session Launcher"
msgstr "Lonchyer Esedhek Wayland GNOME Dyghtyer Displetyans"

#: daemon/main.c:124 daemon/main.c:137
#, c-format
msgid "Cannot write PID file %s: possibly out of disk space: %s"
msgstr "Ny yllir skrifa restren PID %s: martesen nyns eus spas plasen lowr: %s"

#: daemon/main.c:222
msgid "Make all warnings fatal"
msgstr "Gwra oll gwarnyansow marwel"

#: daemon/main.c:223
msgid "Exit after a time (for debugging)"
msgstr "Mos yn-mes wosa prys (rag prevessa)"

#: daemon/main.c:224
msgid "Print GDM version"
msgstr "Pryntya dyllans GDM"

#: daemon/main.c:235
msgid "GNOME Display Manager"
msgstr "GNOME Dyghtyer Displetyans"

#. make sure the pid file doesn't get wiped
#: daemon/main.c:255
msgid "Only the root user can run GDM"
msgstr "An devnydhyer gwreydhek yn unnik a yll eksekutya GDM"

#. Translators: worker is a helper process that does the work
#. of starting up a session
#: daemon/session-worker-main.c:127
msgid "GNOME Display Manager Session Worker"
msgstr "Oberer Esedhek GNOME Dyghtyer Displetyans"

#: data/gnome-greeter.desktop.in:2
msgid "GNOME Greeter"
msgstr "GNOME Dynergher"

#: data/gnome-greeter.desktop.in:3
msgid "The default GNOME Greeter session"
msgstr "An esedhek GNOME Dynergher defowt"

#: data/gnome-initial-setup.desktop.in:2
msgid "GNOME Initial Setup"
msgstr "GNOME Selyans Kynsa"

#: data/gnome-initial-setup.desktop.in:3
msgid "The GNOME Initial Setup session"
msgstr "An esedhek GNOME Selyans Kynsa"

#: data/org.gnome.displaymanager.policy:11
msgid "Allow managing user sessions"
msgstr "Gasa ow tyghtya esedhogow devnydhyer"

#: data/org.gnome.displaymanager.policy:12
msgid "Authentication is required to start or stop a user session"
msgstr "Omgelmyans a res rag dalleth po astel esedhek devnydhyer"

#: data/org.gnome.login-screen.gschema.xml:11
msgid "Whether or not to allow switchable authentication for login"
msgstr "Mar kasa omgelmyans skwychelladow rag omgelmyans"

#: data/org.gnome.login-screen.gschema.xml:14
msgid ""
"The login screen can optionally allow a single PAM service to provide "
"multiple authentication mechanisms via a GDM PAM."
msgstr ""
"An skrin omgelmyans a yll dre dhewis gasa gonis PAM unnik dhe brovia "
"jynnweythow omgelmyans liesek dre PAM GDM."

#: data/org.gnome.login-screen.gschema.xml:21
msgid "Whether or not to allow fingerprint readers for login"
msgstr "Mar kasa redyoryon vys-prynt rag omgelmyans"

#: data/org.gnome.login-screen.gschema.xml:24
msgid ""
"The login screen can optionally allow users who have enrolled their "
"fingerprints to log in using those prints."
msgstr ""
"An skrin omgelmyans a yll dre dhewis gasa devnydhyer neb re ynworrys aga bys-"
"pryntys dhe omgelmi der an pryntys ma."

#: data/org.gnome.login-screen.gschema.xml:31
msgid "Whether or not to allow smartcard readers for login"
msgstr "Mar kasa redyoryon garten gonnyk rag omgelmyans"

#: data/org.gnome.login-screen.gschema.xml:34
msgid ""
"The login screen can optionally allow users who have smartcards to log in "
"using those smartcards."
msgstr ""
"An skrin omgelmyans a yll dre dhewis gasa devnydhyoryon gans kartennow "
"gonnyk dhe omgelmi der an kartennow konnyk na."

#: data/org.gnome.login-screen.gschema.xml:41
msgid "Whether or not to allow passwords for login"
msgstr "Mar kasa geryow-tremena rag omgelmyans"

#: data/org.gnome.login-screen.gschema.xml:44
msgid ""
"The login screen can be configured to disallow password authentication, "
"forcing the user to use smartcard or fingerprint authentication."
msgstr ""
"An skrin omgelmyans a yll bos selys rag digasa omgelmyans ger-tremena, owth "
"ynia an devnydhyer dhe dhevnydhya omgelmyans karten gonnyk po bys-prynt."

#: data/org.gnome.login-screen.gschema.xml:51
msgid "Path to small image at top of user list"
msgstr "Tyller dhe skeusen vyghan a-wartha dhe rol devnydhyer"

#: data/org.gnome.login-screen.gschema.xml:54
msgid ""
"The login screen can optionally show a small image to provide site "
"administrators and distributions a way to display branding."
msgstr ""
"An skrin omgelmyans a yll dre dhewis diskwedhes skeusen vyghan dhe brovia "
"menystroryon ha lesrannansow agwedh rag diskwedhes merkyans."

#: data/org.gnome.login-screen.gschema.xml:61
msgid "Avoid showing user list"
msgstr "Avodya ow tiskwedhes rol dhevnydhyoryon"

#: data/org.gnome.login-screen.gschema.xml:64
msgid ""
"The login screen normally shows a list of available users to log in as. This "
"setting can be toggled to disable showing the user list."
msgstr ""
"Dell yw usys, an skrin omgelmyans a dhiskwedh rol a dhevnydhyoryon gavadow "
"rag omgelmi avel. An settyans ma a yll bos dewisys dhe varowhe diskwedhes an "
"rol dhevnydhyoryon."

#: data/org.gnome.login-screen.gschema.xml:71
msgid "Enable showing the banner message"
msgstr "Bywhe ow tiskwedhes an messach baner"

#: data/org.gnome.login-screen.gschema.xml:74
msgid "Set to true to show the banner message text."
msgstr "Gorra dhe wir rag diskwedhes an tekst messach baner."

#: data/org.gnome.login-screen.gschema.xml:80
msgid "Banner message source"
msgstr "Devedhyans messach baner"

#: data/org.gnome.login-screen.gschema.xml:83
msgid "The source of the text banner message on the login screen."
msgstr "An devedhyans a'n messach baner tekst war'n skrin omgelmyans."

#: data/org.gnome.login-screen.gschema.xml:89
msgid "Banner message text"
msgstr "Tekst messach baner"

#: data/org.gnome.login-screen.gschema.xml:92
msgid "Text banner message to show in the login window."
msgstr "Messach baner tekst rag diskwedhes y'n fenester omgelmyans."

#: data/org.gnome.login-screen.gschema.xml:98
msgid "Banner message path"
msgstr "Tyller messach baner"

#: data/org.gnome.login-screen.gschema.xml:101
msgid "Path to text file with banner message to show in the login window."
msgstr ""
"Tyller dhe restren tekst gans messach baner dhe dhiskwedhes y'n fenester "
"omgelmyans."

#: data/org.gnome.login-screen.gschema.xml:107
msgid "Disable showing the restart buttons"
msgstr "Marowhe ow tiskwedhes an botonyow dastalleth"

#: data/org.gnome.login-screen.gschema.xml:110
msgid "Set to true to disable showing the restart buttons in the login window."
msgstr ""
"Gorra dhe wir dhe varowhe ow tiskwedhes an botonyow dastalleth y'n fenester "
"omgelmyans."

#: data/org.gnome.login-screen.gschema.xml:116
msgid "Number of allowed authentication failures"
msgstr "Niver a dhifygyow omgelmyans gesys"

#: data/org.gnome.login-screen.gschema.xml:119
msgid ""
"The number of times a user is allowed to attempt authentication, before "
"giving up and going back to user selection."
msgstr ""
"An niver a brysyow devnydhyer yw gesys dhe assaya omgelmyans, kyns ow hepkor "
"hag ow tehweles dhe'n dewis devnydhyer."

