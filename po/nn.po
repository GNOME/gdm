#: common/gdm-common.c:324
msgid "/dev/urandom is not a character device"
msgstr "/dev/urandom er ikkje ei teikn-eining"

#: common/gdm-common.c:358
msgid "Unable to create transient display: "
msgstr "Klarte ikkje starte mellombels skjerm: "

#: common/gdm-common.c:555
msgid "Could not identify the current session: "
msgstr "Klarte ikkje identifisere den noverande økta: "

#: common/gdm-common.c:564
msgid "Could not identify the current seat."
msgstr "Klarte ikkje identifisere det noverande setet."

#: daemon/gdm-manager.c:696 daemon/gdm-manager.c:732
msgid "No display available"
msgstr "Ingen skjerm tilgjengeleg"

#: daemon/gdm-manager.c:799 daemon/gdm-manager.c:1106
msgid "No session available"
msgstr "Ingen økt tilgjengeleg"

#: daemon/gdm-manager.c:815
msgid "Can only be called before user is logged in"
msgstr "Kan berre kallast før brukaren er innlogga"

#: daemon/gdm-manager.c:827
msgid "Caller not GDM"
msgstr "Kallaren er ikkje GDM"

#: daemon/gdm-manager.c:837
msgid "Unable to open private communication channel"
msgstr "Klarte ikkje opne privat kommunikasjonskanal"

#: daemon/gdm-session-auditor.c:88
msgid "Username"
msgstr "Brukarnamn"

#: daemon/gdm-session-auditor.c:89
msgid "The username"
msgstr "Brukarnamnet"

#: daemon/gdm-session-auditor.c:93
msgid "Hostname"
msgstr "Vertsnamn"

#: daemon/gdm-session-auditor.c:94
msgid "The hostname"
msgstr "Vertsnamnet"

#: daemon/gdm-session-auditor.c:99
msgid "Display Device"
msgstr "Skjerm-eining"

#: daemon/gdm-session-auditor.c:100
msgid "The display device"
msgstr "Skjerm-eininga"

#: daemon/gdm-session.c:1462
msgid "Could not create authentication helper process"
msgstr "Klarte ikkje opprette prosess for autentiseringshjelparen"

#: daemon/gdm-session-worker.c:819
msgid ""
"You reached the maximum password authentication attempts, please try another "
"method"
msgstr ""
"Du har nådd det maksimale talet på autentiseringsforsøk med passord. Prøv "
"ein annan metode"

#: daemon/gdm-session-worker.c:822
msgid ""
"You reached the maximum auto login attempts, please try another "
"authentication method"
msgstr ""
"Du har nådd det maksimale talet på autentiseringsforsøk med automatisk "
"innlogging. Prøv ein annan metode"

#: daemon/gdm-session-worker.c:825
msgid ""
"You reached the maximum fingerprint authentication attempts, please try "
"another method"
msgstr ""
"Du har nådd det maksimale talet på autentiseringsforsøk med fingeravtrykk. "
"Prøv ein annan metode"

#: daemon/gdm-session-worker.c:828
msgid ""
"You reached the maximum smart card authentication attempts, please try "
"another method"
msgstr ""
"Du har nådd det maksimale talet på autentiseringsforsøk med smartkort. Prøv "
"ein annan metode"

#: daemon/gdm-session-worker.c:830
msgid ""
"You reached the maximum authentication attempts, please try another method"
msgstr ""
"Du har nådd det maksimale talet på autentiseringsforsøk. Prøv ein annan "
"metode"

#: daemon/gdm-session-worker.c:837
msgid "Sorry, password authentication didn’t work. Please try again."
msgstr "Kunne ikkje autentisere med passord. Prøv om att."

#: daemon/gdm-session-worker.c:840
msgid "Sorry, auto login didn’t work. Please try again."
msgstr "Kunne ikkje autentisere med automatisk innlogging. Prøv om att."

#: daemon/gdm-session-worker.c:843
msgid "Sorry, fingerprint authentication didn’t work. Please try again."
msgstr "Kunne ikkje autentisere med fingeravtrykk. Prøv om att."

#: daemon/gdm-session-worker.c:846
msgid "Sorry, smart card authentication didn’t work. Please try again."
msgstr "Kunne ikkje autentisere med smartkort. Prøv om att."

#: daemon/gdm-session-worker.c:848
msgid "Sorry, that didn’t work. Please try again."
msgstr "Det gjekk visst ikkje. Prøv om att."

#: daemon/gdm-session-worker.c:863
msgid "Your account was given a time limit that’s now passed."
msgstr "Kontoen din hadde ei tidsavgrensing som no har gått ut."

#: daemon/gdm-session-worker.c:1297
msgid "Username:"
msgstr "Brukarnamn:"

#: daemon/gdm-session-worker.c:1723 daemon/gdm-session-worker.c:1740
msgid "no user account available"
msgstr "ingen brukarkonto tilgjengeleg"

#: daemon/gdm-session-worker.c:1767
msgid "Unable to change to user"
msgstr "Klarte ikkje å byte til brukar"

#: daemon/gdm-wayland-session.c:513
msgid "GNOME Display Manager Wayland Session Launcher"
msgstr "Wayland-øktstartar for GNOME skjermhandsamar"

#: daemon/main.c:124 daemon/main.c:137
#, c-format
msgid "Cannot write PID file %s: possibly out of disk space: %s"
msgstr "Klarte ikkje skrive PID-fila %s. Kanskje disken er full: %s"

#: daemon/main.c:222
msgid "Make all warnings fatal"
msgstr "Gjer alle åtvaringar fatale"

#: daemon/main.c:223
msgid "Exit after a time (for debugging)"
msgstr "Avslutt etter ei tid (for feilsøking)"

#: daemon/main.c:224
msgid "Print GDM version"
msgstr "Skriv GDM-versjon"

#: daemon/main.c:235
msgid "GNOME Display Manager"
msgstr "GNOME skjermhandsamar"

#. make sure the pid file doesn't get wiped
#: daemon/main.c:255
msgid "Only the root user can run GDM"
msgstr "Det er berre rotbrukaren som kan køyre GDM"

#. Translators: worker is a helper process that does the work
#. of starting up a session
#: daemon/session-worker-main.c:127
msgid "GNOME Display Manager Session Worker"
msgstr "Øktarbeidar for GNOME skjermhandsamar"

#: data/gnome-greeter.desktop.in:2
msgid "GNOME Greeter"
msgstr "GNOME-velkomst"

#: data/gnome-greeter.desktop.in:3
msgid "The default GNOME Greeter session"
msgstr "Standardøkt for GNOME-velkomst"

#: data/gnome-initial-setup.desktop.in:2
msgid "GNOME Initial Setup"
msgstr "GNOME første oppsett"

#: data/gnome-initial-setup.desktop.in:3
msgid "The GNOME Initial Setup session"
msgstr "Økt for første oppsett av GNOME"

#: data/org.gnome.displaymanager.policy:11
msgid "Allow managing user sessions"
msgstr "Tillat å handtere brukarøkter"

#: data/org.gnome.displaymanager.policy:12
msgid "Authentication is required to start or stop a user session"
msgstr "Det trengst autentisering for å starte eller stoppe ei brukarøkt"

#: data/org.gnome.login-screen.gschema.xml:11
msgid "Whether or not to allow switchable authentication for login"
msgstr ""
"Styrar om det skal vere mogleg å byte mellom ulike måtar å logge inn på"

#: data/org.gnome.login-screen.gschema.xml:14
msgid ""
"The login screen can optionally allow a single PAM service to provide "
"multiple authentication mechanisms via a GDM PAM."
msgstr ""
"Innloggingsskjermen kan eventuelt tillate at ei enkelt PAM-teneste tilbyr "
"fleire autentiseringsmekanismar via ein GDM PAM."

#: data/org.gnome.login-screen.gschema.xml:21
msgid "Whether or not to allow fingerprint readers for login"
msgstr "Styrar om det skal vere mogleg å logge inn med fingeravtrykkslesarar"

#: data/org.gnome.login-screen.gschema.xml:24
msgid ""
"The login screen can optionally allow users who have enrolled their "
"fingerprints to log in using those prints."
msgstr ""
"Innloggingsskjermen kan eventuelt tillate at brukarar som har lagt inn "
"fingeravtrykka sine, kan logge inn med fingeravtrykk."

#: data/org.gnome.login-screen.gschema.xml:31
msgid "Whether or not to allow smartcard readers for login"
msgstr "Styrar om det skal vere mogleg å logge inn med smartkortlesarar"

#: data/org.gnome.login-screen.gschema.xml:34
msgid ""
"The login screen can optionally allow users who have smartcards to log in "
"using those smartcards."
msgstr ""
"Innloggingsskjermen kan eventuelt tillate at brukarar som har lagt inn "
"smartkorta sine, kan logge inn med smartkort."

#: data/org.gnome.login-screen.gschema.xml:41
msgid "Whether or not to allow passwords for login"
msgstr "Styrar om det skal vere mogleg å logge inn med passord"

#: data/org.gnome.login-screen.gschema.xml:44
msgid ""
"The login screen can be configured to disallow password authentication, "
"forcing the user to use smartcard or fingerprint authentication."
msgstr ""
"Innloggingsskjermen kan setjast opp slik at ein ikkje kan logge inn med "
"passord, men berre med smartkort eller fingeravtrykk."

#: data/org.gnome.login-screen.gschema.xml:51
msgid "Path to small image at top of user list"
msgstr "Sti til lite bilete øvst på brukarlista"

#: data/org.gnome.login-screen.gschema.xml:54
msgid ""
"The login screen can optionally show a small image to provide site "
"administrators and distributions a way to display branding."
msgstr ""
"Innloggingsskjermen kan eventuelt vise eit lite bilete, slik at "
"administratorar og distribusjonar kan vise varemerket sitt."

#: data/org.gnome.login-screen.gschema.xml:61
msgid "Avoid showing user list"
msgstr "Unngå å vise brukarlista"

#: data/org.gnome.login-screen.gschema.xml:64
msgid ""
"The login screen normally shows a list of available users to log in as. This "
"setting can be toggled to disable showing the user list."
msgstr ""
"Innloggingsskjermen viser normalt ei liste over tilgjengelege brukarar som "
"kan logge inn. Dersom denne innstillinga er på, synest ikkje brukarlista."

#: data/org.gnome.login-screen.gschema.xml:71
msgid "Enable showing the banner message"
msgstr "Vis melding i banneret"

#: data/org.gnome.login-screen.gschema.xml:74
msgid "Set to true to show the banner message text."
msgstr "Sett til sann for å vise melding i banneret."

#: data/org.gnome.login-screen.gschema.xml:80
msgid "Banner message source"
msgstr "Kjelde for melding i banneret"

#: data/org.gnome.login-screen.gschema.xml:83
msgid "The source of the text banner message on the login screen."
msgstr "Kjelda til meldinga i banneret i innloggingsvindauget."

#: data/org.gnome.login-screen.gschema.xml:89
msgid "Banner message text"
msgstr "Melding i banneret"

#: data/org.gnome.login-screen.gschema.xml:92
msgid "Text banner message to show in the login window."
msgstr "Meldinga som skal visast i banneret i innloggingsvindauget."

#: data/org.gnome.login-screen.gschema.xml:98
msgid "Banner message path"
msgstr "Sti for meldinga i banneret"

#: data/org.gnome.login-screen.gschema.xml:101
msgid "Path to text file with banner message to show in the login window."
msgstr "Stien til tekstfila med meldinga som skal visast innloggingsvindauget."

#: data/org.gnome.login-screen.gschema.xml:107
msgid "Disable showing the restart buttons"
msgstr "Ikkje vis omstartknappane"

#: data/org.gnome.login-screen.gschema.xml:110
msgid "Set to true to disable showing the restart buttons in the login window."
msgstr "Slå på for å skjule omstartknappane i innloggingsvindauget."

#: data/org.gnome.login-screen.gschema.xml:116
msgid "Number of allowed authentication failures"
msgstr "Tal på tillatne mislukka autentiseringsforsøk"

#: data/org.gnome.login-screen.gschema.xml:119
msgid ""
"The number of times a user is allowed to attempt authentication, before "
"giving up and going back to user selection."
msgstr ""
"Talet på gonger brukaren kan prøve å autentisere seg før hen vert omdirigert "
"attende til brukarval."

#: utils/gdm-config.c:117
msgid "Show command help"
msgstr "Vis kommandohjelp"

#: utils/gdm-config.c:121
msgid "Show verbose output"
msgstr "Vis omstendeleg utdata"

#: utils/gdm-config.c:125
msgid "Show debug output"
msgstr "Vis debugutdata"

#: utils/gdm-config.c:134
msgid "Enable the authentication method"
msgstr "Slå på autentiseringsmetoden"

#: utils/gdm-config.c:138
msgid "Disable the authentication method"
msgstr "Slå av autentiseringsmetoden"

#: utils/gdm-config.c:147
msgid "Require the authentication method"
msgstr "Krev autentiseringsmetoden"

#: utils/gdm-config.c:151
msgid "Action to perform on smartcard removal"
msgstr "Handling å utføre ved fjerning av smartkort"

#: utils/gdm-config.c:160
msgid "Assume yes to any answer"
msgstr "Anta ja som svar på alle spørsmål"

#: utils/gdm-config.c:262
msgid "Configure Password Authentication."
msgstr "Sett opp autentisering med passord."

#: utils/gdm-config.c:264
msgid "Configure Fingerprint Authentication."
msgstr "Sett opp autentisering med fingeravtrykk."

#: utils/gdm-config.c:266
msgid "Configure Smart Card Authentication."
msgstr "Sett opp autentisering med smartkort."

#: utils/gdm-config.c:268
msgid "Reset the GDM Authentication configuration."
msgstr "Nullstill konfigurasjonen av GDM-autentisering."

#: utils/gdm-config.c:270
msgid "Show GDM Authentication configuration."
msgstr "Vis konfigurasjonen av GDM-autentisering."

#: utils/gdm-config.c:281
msgid "Password options"
msgstr "Passordval"

#: utils/gdm-config.c:283
msgid "Fingerprint options"
msgstr "Fingeravtrykksval"

#: utils/gdm-config.c:285
msgid "Smart Card options"
msgstr "Smartkortval"

#: utils/gdm-config.c:287
msgid "Reset options"
msgstr "Nullstill val"

#: utils/gdm-config.c:289
msgid "Show options"
msgstr "Vis val"

#: utils/gdm-config.c:319
msgid "No PAM module available for Password authentication"
msgstr "Ingen PAM-modul tilgjengeleg for autentisering med passord"

#: utils/gdm-config.c:321
msgid "No PAM module available for Smart Card authentication"
msgstr "Ingen PAM-modul tilgjengeleg for autentisering med smartkort"

#: utils/gdm-config.c:323
msgid "No PAM module available for Fingerprint authentication"
msgstr "Ingen PAM-modul tilgjengeleg for autentisering med fingeravtrykk"

#: utils/gdm-config.c:354
#, c-format
msgid "“%s” needs at least one parameter"
msgstr "«%s» treng minst éin parameter"

#. TRANSLATORS: “command” can't be enabled...
#: utils/gdm-config.c:363
#, c-format
msgid "“%s” can't be enabled and disabled at the same time"
msgstr "«%s» kan ikkje vere slege på og av samstundes"

#. TRANSLATORS: option is not a valid command “option-key” value
#: utils/gdm-config.c:386
#, c-format
msgid "“%s” is not a valid %s “%s” value"
msgstr "«%s» er ikkje ein gyldig %s «%s»-verdi"

#: utils/gdm-config.c:633
msgid "No distro detected, no hook to run"
msgstr "Ingen distribusjon gjenkjend – ingen koplingar å køyre"

#: utils/gdm-config.c:651
#, c-format
msgid "No valid args found to run hook “%s”"
msgstr "Ingen gyldige argument funne for å køyre koplinga «%s»"

#: utils/gdm-config.c:656
#, c-format
msgid "Running distro hook “%s”\n"
msgstr "Køyrer distribusjonskoplinga «%s»\n"

#: utils/gdm-config.c:670
#, c-format
msgid "Distro hook “%s” requested stopping"
msgstr "Distrobusjonskoplinga «%s» spurde om å stoppe"

#: utils/gdm-config.c:683
#, c-format
msgid ""
"Distro hook failed with exit status %d and error %s:\n"
"Standard output:\n"
"%s\n"
"Error output:\n"
"%s"
msgstr ""
"Distribusjonskoplinga mislyktes med avslutningsstatusen %d og feil %s:\n"
"Standard utdata:\n"
"%s\n"
"Feilutdata:\n"
"%s"

#. TRANSLATORS: Failed to set command “command” option key “option-key” via distro hook
#: utils/gdm-config.c:733
#, c-format
msgid "Failed to set command “%s” option key “%s” via distro hook: "
msgstr ""
"Klarte ikkje setje kommandoen «%s» med valtasten «%s» via "
"distribusjonskopling: "

#: utils/gdm-config.c:773
#, c-format
msgid "Failed to create directory %s"
msgstr "Klarte ikkje opprette katalogen %s"

#: utils/gdm-config.c:844
msgid "dconf profile not found"
msgstr "dconf-profilen vart ikkje funne"

#: utils/gdm-config.c:934
msgid "dconf has no system-db configured"
msgstr "dconf har ikkje nokon system-db konfigurert"

#. TRANSLATORS: First value is a file path, second is an error message
#: utils/gdm-config.c:1083
#, c-format
msgid "Failed to get the “%s” header comment: %s, was it modified?"
msgstr "Mislukkast i å hente overskriftskommentaren «%s»: %s. Vart han endra?"

#: utils/gdm-config.c:1086
#, c-format
msgid "File “%s” header comment does not match, was it modified?"
msgstr "Overskriftskommentaren til fila «%s» samsvarar ikkje. Vart ho endra?"

#. XXX: Fail with an error instead?
#: utils/gdm-config.c:1214
#, c-format
msgid "No expected header found on lock file “%s”, was it modified?"
msgstr "Inga forventa overskrift funnen på låsfila «%s». Vart ho endra?"

#: utils/gdm-config.c:1509
msgid "Failed to run a required distro hook: "
msgstr "Klarte ikkje køyre påkravd distribusjonskopling: "

#: utils/gdm-config.c:1525
msgid "COMMAND"
msgstr "KOMMANDO"

#: utils/gdm-config.c:1529
#, c-format
msgid ""
"Commands:\n"
"  help         Shows this information\n"
"  password     Configure the password authentication\n"
"  fingerprint  Configure the fingerprint authentication\n"
"  smartcard    Configure the smartcard authentication\n"
"  reset        Resets the default configuration\n"
"  show         Shows the current configuration\n"
"\n"
"Use “%s COMMAND --help” to get help on each command.\n"
msgstr ""
"Kommandoar:\n"
"  help         Viser desse opplysingane\n"
"  password     Konfigurer autentisering med passord\n"
"  fingerprint  Konfigurer autentisering med fingeravtrykk\n"
"  smartcard    Konfigurer autentisering med smartkort\n"
"  reset        Nullstill til standardkonfigureringa\n"
"  show         Viser den noverande konfigureringa\n"
"\n"
"Bruk «%s KOMMANDO --help» for å få hjelp på kvar kommando.\n"

#: utils/gdm-config.c:1591
msgid "Command options"
msgstr "Kommandoval"

#. TRANSLATORS: You need to be root to use PROGRAM-NAME “command” command
#: utils/gdm-config.c:1626
#, c-format
msgid "You need to be root to use %s “%s” command"
msgstr "Du må vere rotbrukar for å bruke %s «%s»-kommandoen"

#: utils/gdm-config.c:1676
#, c-format
msgid "Failed to set %s setting: "
msgstr "Klarte ikkje stille inn %s-innstillinga: "

#: utils/gdm-config.c:1768
msgid "Failed to set smartcard setting"
msgstr "Klarte ikkje stille inn smartkortinnstillinga"

#: utils/gdm-config.c:1774
msgid "Failed to set password setting"
msgstr "Klarte ikkje stille inn passordinnstillinga"

#: utils/gdm-config.c:1788
msgid "Enabled"
msgstr "Slegen på"

#: utils/gdm-config.c:1788
msgid "Disabled"
msgstr "Slegen av"

#: utils/gdm-config.c:1797
msgid "Not supported"
msgstr "Ikkje stødd"

#: utils/gdm-config.c:1813
msgid "Required"
msgstr "Påkravd"

#: utils/gdm-config.c:1865
#, c-format
msgid ""
"GDM Authorization configuration\n"
"\n"
"  Password authentication: %s\n"
"  Fingerprint authentication: %s\n"
"  Smart Card authentication: %s\n"
"  Smart Card removal action: %s\n"
msgstr ""
"Konfigurering av GDM-autentisering\n"
"\n"
"  Autentisering med passord: %s\n"
"  Autentisering med fingeravtrykk: %s\n"
"  Autentisering med smartkort: %s\n"
"  Handling ved fjerning av smartkort: %s\n"

#: utils/gdm-config.c:1893
msgctxt "Interactive question"
msgid "Y"
msgstr "J"

#: utils/gdm-config.c:1894
msgctxt "Interactive question"
msgid "y"
msgstr "j"

#: utils/gdm-config.c:1895
msgctxt "Interactive question"
msgid "N"
msgstr "N"

#: utils/gdm-config.c:1896
msgctxt "Interactive question"
msgid "n"
msgstr "n"

#: utils/gdm-config.c:1900
msgctxt "Interactive question"
msgid "Do you want to continue? [Y/n]? "
msgstr "Vil du halde fram? [J/n]? "

#: utils/gdm-config.c:1918
msgid "User cancelled the request"
msgstr "Brukaren avbraut førespurnaden"

